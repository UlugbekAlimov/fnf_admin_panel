{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@fnf-admin/management": ["libs/features/management/src/index.ts"],
      "@fnf-admin/education": ["libs/features/education/src/index.ts"],
      "@fnf-admin/environment": ["apps/fnf_admin/src/environment/environment.ts"],
      "@fnf-admin/platform": ["libs/features/platform/src/index.ts"],
      "@fnf_admin/core": ["libs/core/status.enum.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
